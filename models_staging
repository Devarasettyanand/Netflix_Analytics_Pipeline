  imdbId AS imdb_id,
  tmdbId AS tmdb_id
FROM raw_links

#src_movies.sql
WITH raw_movies AS (
    SELECT * FROM {{ source('netflix', 'r_movies') }}
)
SELECT 
    movieId AS movie_id,
    title,
    genres
FROM raw_movies

#src_ratings.sql
