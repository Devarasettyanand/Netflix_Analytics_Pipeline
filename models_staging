#src_genome_score.sql
WITH raw_genome_scores AS (
  SELECT * FROM MOVIELENS.RAW.RAW_GENOME_SCORES
)

SELECT
  movieId AS movie_id,
  tagId AS tag_id,
  relevance
FROM raw_genome_scores

#src_genome_tags.sql
WITH raw_genome_tags AS (
  SELECT * FROM MOVIELENS.RAW.RAW_GENOME_TAGS
)

SELECT
  tagId AS tag_id,
  tag
FROM raw_genome_tags

#src_links.sql
